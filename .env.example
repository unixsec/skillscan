# Copy to .env and fill in real values before running docker-compose up.
# NEVER commit a real .env (already covered by .gitignore).
#
# ⚠ ESCAPE EVERY `$` IN A VALUE AS `$$`. docker compose interpolates this file
# before anything reads it, so a password written `ab$cd` reaches the container
# as `ab` - the `$cd` is treated as an undefined variable and silently removed
# (measured, 2026-07-29: compose only warns for `${...}` forms, a bare `$x`
# passes without a word). Written `ab$$cd` it arrives correctly as `ab$cd`.
# This matters most for the DB passwords below: the truncation is CONSISTENT,
# so `migrate` creates the account with the short password and the monolith
# connects with the same short password, and everything works - until someone
# tries the password they actually chose, or an audit asks how long it is.
#
# Every value below is genuinely required for a REAL production deployment
# (coding spec §13's own "no hardcoded secrets" constraint) - there are no
# working defaults baked in here, unlike scripts/one_click_dev.sh's dev-only
# shortcuts. Leaving Vault/OIDC/SAML unset means the monolith starts and
# serves read-only/public routes, but no one can log in (break-glass stays
# disabled per INV-17 unless SKILLSCAN_BREAKGLASS_ENABLED=true AND Vault is
# reachable) - see docs/DEPLOYMENT_GUIDE.md for the full picture.

# ---- MySQL root (used only by the one-shot `migrate` service + docker-
#      compose's own healthcheck - the running monolith never uses root) ----
SKILLSCAN_MYSQL_ROOT_PASSWORD=

# ---- Per-module MySQL passwords (policies/grants/manifest.yaml's own
#      password_env names - one per least-privilege service account) ----
SKILLSCAN_DB_PASSWORD_ORCHESTRATION=
SKILLSCAN_DB_PASSWORD_GATE=
SKILLSCAN_DB_PASSWORD_REEVAL=
SKILLSCAN_DB_PASSWORD_REPORTING=
SKILLSCAN_DB_PASSWORD_INVENTORY=
SKILLSCAN_DB_PASSWORD_AUDIT=
SKILLSCAN_DB_PASSWORD_INTEL=

# ---- Vault (judgment signing key + break-glass credential storage) ----
SKILLSCAN_VAULT_ADDR=
SKILLSCAN_VAULT_TOKEN=
SKILLSCAN_VAULT_TRANSIT_KEY_NAME=skillscan-gate-signing

# ---- Break-glass local-admin (INV-17: default-disabled, MFA+two-person) ----
SKILLSCAN_BREAKGLASS_ENABLED=false
SKILLSCAN_BREAKGLASS_VAULT_SECRET_PATH=skillscan/breakglass

# ---- OIDC (real enterprise IdP - leave SKILLSCAN_OIDC_ISSUER unset to
#      disable this login path entirely, e.g. if only SAML is used) ----
SKILLSCAN_OIDC_ISSUER=
SKILLSCAN_OIDC_CLIENT_ID=
SKILLSCAN_OIDC_CLIENT_SECRET=
SKILLSCAN_OIDC_REDIRECT_URI_ALLOWLIST=
SKILLSCAN_OIDC_AUTHORIZATION_ENDPOINT=
SKILLSCAN_OIDC_TOKEN_ENDPOINT=
SKILLSCAN_OIDC_JWKS_URI=

# ---- SAML (real enterprise IdP - leave SKILLSCAN_SAML_SP_ENTITY_ID unset to
#      disable this login path entirely, e.g. if only OIDC is used) ----
SKILLSCAN_SAML_SP_ENTITY_ID=
SKILLSCAN_SAML_SP_ACS_URL=
SKILLSCAN_SAML_IDP_ENTITY_ID=
SKILLSCAN_SAML_IDP_SSO_URL=
SKILLSCAN_SAML_IDP_SLO_URL=
SKILLSCAN_SAML_IDP_X509_CERT=

# ---- Session introspection (RFC 7662, coding spec §11.2 path B) ----
SKILLSCAN_SESSION_INTROSPECTION_ENDPOINT=
SKILLSCAN_SESSION_INTROSPECTION_CLIENT_ID=
SKILLSCAN_SESSION_INTROSPECTION_CLIENT_SECRET=

# ---- Marketplace writeback + reconciliation (leave API base URL unset to
#      disable - outbox drain falls back to log-only) ----
SKILLSCAN_MARKETPLACE_API_BASE_URL=
SKILLSCAN_MARKETPLACE_POLL_TOKEN=
SKILLSCAN_MARKETPLACE_WRITE_TOKEN=
SKILLSCAN_RECONCILIATION_POLL_ENABLED=false
SKILLSCAN_RECONCILIATION_PUSH_ENABLED=false
SKILLSCAN_RECONCILIATION_PUSH_HMAC_SECRET=

# ---- SIEM (CEF-over-syslog - leave unset to disable) ----
SKILLSCAN_SIEM_ENDPOINT=

# ---- M2M (comma-separated client_id allowlist for client-credentials/mTLS
#      service-account callers) ----
SKILLSCAN_M2M_ALLOWED_SERVICE_ACCOUNTS=

# ---- Intel (dir of trusted RSA public keys for offline signed-package
#      import verification - leave unset to fail-closed reject all imports) ----
SKILLSCAN_INTEL_TRUSTED_KEYS_DIR=

# ---- Sandbox engines (services/engine_runner - yara, bandit, osv-scanner,
#      skillspector, aig-mcp-scan) ----
#
# SKILLSCAN_VLLM_BASE_URL is read by BOTH deployables from this one value
# (docker-compose.yml's x-shared-engine-env anchor). Setting it on only one of
# them is a real, silent split-brain: the engine-runner constructs the LLM
# engines and runs them, the monolith never waits for their results, and the
# console reports the engine as "not built" on a scan whose row shows it
# failed. INV-14: it must resolve INTERNALLY - an enterprise's own privatized
# model deployment counts, api.openai.com does not (it is rejected outright).
# Leave empty and: skillspector still runs its static SARIF checks with
# use_llm=False, and aig-mcp-scan is not constructed at all (it has no
# static-only mode).
SKILLSCAN_VLLM_BASE_URL=
# Only meaningful with the above set: for an internal deployment that enforces
# its own auth and/or serves one specific named model.
SKILLSCAN_LLM_API_KEY=
SKILLSCAN_LLM_MODEL=
# osv-scanner's adapter hardcodes --offline as a security decision and does not
# consume this; it exists for config-schema completeness and is validated like
# every other endpoint field (anything other than the literal "offline" must
# resolve internally).
SKILLSCAN_OSV_SOURCE=offline

# ---- Scan/engine time budgets ----
#
# SKILLSCAN_SCAN_DEADLINE_S is one scan job's whole wall clock. The monolith
# ENFORCES it; the engine-runner reads the same value only to warn at startup
# when the per-engine timeouts cannot all fit inside it. Both get it from this
# one entry.
#
# Leave the three below empty/default and the engines fit: with no LLM endpoint
# the engine-runner builds four engines at 60s each = 240s, inside the 300s
# deadline, and it starts quietly. Set SKILLSCAN_VLLM_BASE_URL above and
# aig-mcp-scan joins at 240s, making the total 480s > 300s - the engine-runner
# will say so at EVERY start until this is raised to >= 480. The engines are
# run sequentially against one shared deadline and each is clamped to the
# budget REMAINING when its turn comes, so an unraised deadline does not
# overrun anything; it silently starves the last engines instead.
#
# NOTE if you raise it: SKILLSCAN_SANDBOX_WAIT_TIMEOUT_S (how long the gate
# waits for the sandbox tier before deciding without it) defaults to 300 too
# and is deliberately kept equal - raise both, or the gate stops waiting while
# the engines are still allowed to run.
SKILLSCAN_SCAN_DEADLINE_S=300
# Global per-engine subprocess timeout; empty means the built-in 60s (240s for
# aig-mcp-scan, which runs a multi-turn agent loop).
SKILLSCAN_ENGINE_TIMEOUT_S=
# Per-engine overrides, keyed by the engine's real name. An unknown key stops
# the engine-runner at startup rather than being silently ignored.
# Example: {"aig-mcp-scan": 600, "skillspector": 120}
SKILLSCAN_ENGINE_TIMEOUTS_JSON=

# ---- Build-time-only: internal package mirrors (INV-14 zero-outbound-build,
#      leave empty in an environment with real public internet access) ----
SKILLSCAN_PIP_INDEX_URL=
SKILLSCAN_NPM_REGISTRY=
# Go module proxy for osv-scanner's dependency graph. Vendoring osv-scanner's
# SOURCE did not vendor its Go MODULES - see docs/DEPLOYMENT_GUIDE.md §0.
SKILLSCAN_GOPROXY=
